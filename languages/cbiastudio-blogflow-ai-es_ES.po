#: includes/admin/views/blog.php:445
msgid "Add one post title per row in the first column."
msgstr "Agregue un título de publicación por fila en la primera columna."

#: includes/admin/views/blog.php:446
msgid ""
"Upload the CSV to a public URL (Google Drive, Dropbox, your site, etc.)."
msgstr "Sube el CSV a una URL pública (Google Drive, Dropbox, tu sitio, etc.)."

#: includes/admin/views/blog.php:447
